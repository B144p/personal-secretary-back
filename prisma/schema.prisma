generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  google_id     String   @unique
  email         String   @unique
  name          String?
  avatar_url    String?
  refresh_token String
  create_at     DateTime @default(now())
  update_at     DateTime @updatedAt

  user_state UserState?
  plan       Plan[]

  @@map("user")
}

model UserState {
  id      String @id @default(cuid())
  user_id String @unique

  working_hours_start String    @default("10:00")
  working_hours_end   String    @default("20:00")
  days_off            Int[]     @default([0])
  time_zone           String    @default("Asia/Bangkok")
  special_days        Json      @default("[]")
  last_calendar_sync  DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_state")
}

model Plan {
  id          String           @id @default(uuid())
  user_id     String
  title       String
  source_id   String?
  source_type EPlanSourceType?
  status      EPlanStatus
  is_paused   Boolean          @default(false)

  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  user      User            @relation(fields: [user_id], references: [id])
  tasks     Task[]
  feedbacks DailyFeedback[]

  @@map("plan")
}

model DailyFeedback {
  id             String   @id @default(uuid())
  plan_id        String
  date           DateTime
  status_changes Json
  context_text   String?
  created_at     DateTime @default(now())

  plan Plan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([plan_id, created_at])
  @@map("daily_feedback")
}

model Task {
  id               String      @id @default(uuid())
  plan_id          String
  parent_task_id   String?
  title            String
  description      String?
  status           ETaskStatus @default(PENDING)
  depth            Int         @default(0)
  sequence_order   Int         @default(0)
  estimated_minutes Int?

  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  plan     Plan        @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  parent   Task?       @relation("TaskTree", fields: [parent_task_id], references: [id])
  children Task[]      @relation("TaskTree")
  events   TaskEvent[]

  @@map("task")
}

model TaskEvent {
  id              String   @id @default(uuid())
  task_id         String
  google_event_id String
  start           DateTime
  end             DateTime
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_event")
}

model CategoryRule {
  id       String         @id @default(uuid())
  keyword  String         @unique
  category EEventCategory @default(UNKNOWN)

  create_at    DateTime                 @default(now())
  update_at    DateTime                 @updatedAt
  keyword_tags CategoryRuleKeywordTag[]

  @@map("category_rule")
}

model CategoryRuleTag {
  id  String @id @default(uuid())
  tag String @unique

  create_at    DateTime                 @default(now())
  update_at    DateTime                 @updatedAt
  keyword_tags CategoryRuleKeywordTag[]

  @@map("category_rule_tag")
}

model CategoryRuleKeywordTag {
  tag_id           String
  category_rule_id String

  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  category_rule CategoryRule    @relation(fields: [category_rule_id], references: [id], onDelete: Cascade)
  tag           CategoryRuleTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([category_rule_id, tag_id])
  @@map("category_rule_keyword_tag")
}

enum EEventCategory {
  DEEP_WORK
  MEETING
  CHORE
  HEALTH
  PERSONAL
  UNKNOWN
}

enum EPlanSourceType {
  GENERATE
  CALENDAR
}

enum EPlanStatus {
  DRAFT
  READY
  SCHEDULED
  HOLD
  DONE
}

enum ETaskStatus {
  HOLD
  PENDING
  IN_PROGRESS
  DONE
}
